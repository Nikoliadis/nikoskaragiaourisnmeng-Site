# Copy to .env and adjust. Never commit the real .env.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=

# Where uploaded documents are stored (keep OUTSIDE the web root in production).
# PROTECTED_MEDIA_ROOT=/var/www/protected_media

# Max upload size in bytes (default 25 MB).
MAX_UPLOAD_SIZE=26214400
