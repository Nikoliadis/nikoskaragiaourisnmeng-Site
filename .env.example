# Copy to .env (στη ρίζα του project) and adjust. Never commit the real .env.
# Required when DJANGO_DEBUG=False — the site refuses to start without it.
# Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=

# Where uploaded documents are stored. Defaults to Database/protected_media.
# In production keep this OUTSIDE the web server's document root.
# PROTECTED_MEDIA_ROOT=/var/www/protected_media

# Max upload size in bytes (default 25 MB).
MAX_UPLOAD_SIZE=26214400

# Number of reverse proxies in front of Django (nginx = 1). Only set this in
# production: it tells django-axes which X-Forwarded-For entry is the real
# client, so one attacker cannot lock out every visitor.
# DJANGO_PROXY_COUNT=1

# Where the security log is written (default Database/logs).
# DJANGO_LOG_DIR=/var/log/karagiaouris
